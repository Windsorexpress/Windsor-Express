{
  "name": "windsor-express-site",
  "private": true,
  "scripts": {
    "build:js": "esbuild ./src/app.jsx --bundle=false --format=iife --jsx=transform --target=es2018 --minify --outfile=./app.js",
    "build:css": "tailwindcss -i ./src/tailwind.css -o ./site.css --minify",
    "build": "npm run build:js && npm run build:css"
  },
  "devDependencies": {
    "esbuild": "0.25.6",
    "tailwindcss": "3.4.17"
  }
}
