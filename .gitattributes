# Keep line endings consistent between Windows checkouts and the Linux
# GitHub Action that regenerates the feeds. Without this, Windows rewrites
# the generated files to CRLF, git reports them as modified even when the
# content is identical, and the hourly workflow commits noise every run.
* text=auto eol=lf

# Generated by scripts/ — always LF, never touched by hand
merchant-feed.xml   text eol=lf
local-inventory.xml text eol=lf
sitemap.xml         text eol=lf
phones/**/*.html    text eol=lf

# Binary assets: never convert
*.png  binary
*.jpg  binary
*.jpeg binary
*.ico  binary
*.pdf  binary
